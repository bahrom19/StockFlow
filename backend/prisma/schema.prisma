generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  KZT
  USD
  EUR
  RUB
  CNY
  AED
  AUD
  VND
}

enum Language {
  ru
  kk
  en
  uz
  vi
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CustomerType {
  PERSON
  COMPANY
}

enum UserStatus {
  ACTIVE
  INVITED
  BLOCKED
  DELETED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING_BALANCE
  COUNT_ADJUSTMENT
  RESERVATION
  UNRESERVATION
  PRODUCTION_IN
  PRODUCTION_OUT
}

enum InventoryCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CostingMethod {
  FIFO
  AVERAGE
  STANDARD
}

enum StockStatus {
  AVAILABLE
  RESERVED
  QUARANTINE
  DAMAGED
  EXPIRED
  RETURNED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  APPROVED
  COMPLETED
  CANCELLED
}

model Company {
  id                    String        @id @default(uuid()) @db.Uuid
  name                  String        @db.VarChar(255)
  legalName             String?       @db.VarChar(255)
  bin                   String?       @db.VarChar(64)
  email                 String?       @db.VarChar(255)
  phone                 String?       @db.VarChar(64)
  website               String?       @db.VarChar(255)
  country               String?       @db.VarChar(100)
  city                  String?       @db.VarChar(100)
  address               String?       @db.VarChar(255)
  postalCode            String?       @db.VarChar(32)
  timezone              String?       @db.VarChar(64)
  currency              Currency      @default(KZT)
  language              Language      @default(ru)
  status                CompanyStatus @default(ACTIVE)
  logoUrl               String?       @db.Text
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  members               CompanyMember[]
  roles                 Role[]
  products              Product[]
  warehouses           Warehouse[]
  customers             Customer[]
  customerGroups        CustomerGroup[]
  suppliers             Supplier[]
  stocks                Stock[]
  stockMovements        StockMovement[]
  auditLogs             AuditLog[]
  purchaseOrders        PurchaseOrder[]
  batches               Batch[]
  costLayers            CostLayer[]
  inventoryCounts       InventoryCount[]
  unitsOfMeasure        UnitOfMeasure[]
  goodsReceipts         GoodsReceipt[]
  purchaseReturns       PurchaseReturn[]
  purchaseInvoices      PurchaseInvoice[]
  creditNotes           PurchaseCreditNote[]
  rfqs                  RFQ[]
  quotations            SupplierQuotation[]
  sales                 Sale[]
  cashShifts            CashShift[]
  chartOfAccounts       ChartOfAccount[]
  financialPeriods      FinancialPeriod[]
  cashAccounts          CashAccount[]
  bankAccounts          BankAccount[]
  journalEntries        JournalEntry[]
  financialTransactions FinancialTransaction[]
  accountBalances       AccountBalance[]
  opportunities         SalesOpportunity[]
  tasks                 Task[]
  fiscalYears           FiscalYear[]
  subscriptions         CompanySubscription[]
  billingInvoices       Invoice[]
  billingUsageRecords   UsageRecord[]
  billingPaymentTransactions PaymentTransaction[]
  documentSequences     DocumentSequence[]

  @@index([name])
  @@index([status])
  @@index([createdAt])
  @@index([isActive, deletedAt])
}

model DocumentSequence {
  companyId  String   @db.Uuid
  type       String   @db.VarChar(64)
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, type])
}

model CustomerGroup {
  id                String      @id @default(uuid()) @db.Uuid
  companyId         String      @db.Uuid
  name              String      @db.VarChar(255)
  discountPercent   Decimal?    @db.Decimal(5, 2)
  description       String?     @db.Text
  rowVersion        Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers         Customer[]

  @@index([companyId])
  @@index([name])
  @@index([createdAt])
  @@index([companyId, deletedAt])
}

model Customer {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  groupId       String?       @db.Uuid
  type          CustomerType  @default(PERSON)
  firstName     String?       @db.VarChar(100)
  lastName      String?       @db.VarChar(100)
  companyName   String?       @db.VarChar(255)
  iin           String?       @db.VarChar(20)
  bin           String?       @db.VarChar(20)
  email         String?       @db.VarChar(255)
  phone         String?       @db.VarChar(64)
  mobile        String?       @db.VarChar(64)
  discount      Decimal?      @db.Decimal(18, 4)
  creditLimit   Decimal?      @db.Decimal(18, 4)
  currentDebt   Decimal?      @db.Decimal(18, 4)
  bonusPoints   Int           @default(0)
  notes         String?       @db.Text
  isActive      Boolean       @default(true)
  rowVersion    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group         CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  addresses     CustomerAddress[]
  contacts      CustomerContact[]
  creditLimits  CreditLimit[]
  loyaltyAccount LoyaltyAccount?
  priceList     PriceList?
  opportunities SalesOpportunity[]
  tasks         Task[]
  customerNotes CustomerNote[]
  sales         Sale[]

  @@index([companyId])
  @@index([groupId])
  @@index([email])
  @@index([phone])
  @@index([bin])
  @@index([iin])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([companyId, isActive])
  @@index([companyId, createdAt])
}

model CustomerContact {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @db.Uuid
  firstName   String?   @db.VarChar(100)
  lastName    String?   @db.VarChar(100)
  phone       String?   @db.VarChar(64)
  email       String?   @db.VarChar(255)
  position    String?   @db.VarChar(100)
  isPrimary   Boolean   @default(false)
  notes       String?   @db.Text
  rowVersion  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
  @@index([phone])
}

model CreditLimit {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @db.Uuid
  amount      Decimal   @db.Decimal(18, 4)
  currency    Currency  @default(KZT)
  approvedBy  String?   @db.Uuid
  approvedAt  DateTime?
  notes       String?   @db.Text
  rowVersion  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model LoyaltyAccount {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @unique @db.Uuid
  points      Int      @default(0)
  lifetimePoints Int   @default(0)
  tier        String   @default("STANDARD") @db.VarChar(50)
  enrolledAt  DateTime @default(now())
  lastActivity DateTime?
  rowVersion  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tier])
}

model PriceList {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @unique @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  rowVersion  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       PriceListItem[]

  @@index([customerId])
  @@index([isActive])
}

model PriceListItem {
  id          String    @id @default(uuid()) @db.Uuid
  priceListId String    @db.Uuid
  productId   String    @db.Uuid
  unitPrice   Decimal   @db.Decimal(18, 4)
  discount    Decimal?  @db.Decimal(5, 2)
  rowVersion  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([priceListId])
  @@index([productId])
}

enum OpportunityStatus {
  NEW
  QUALIFYING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  ABANDONED
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SalesOpportunity {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @db.Uuid
  customerId  String              @db.Uuid
  title       String              @db.VarChar(255)
  description String?             @db.Text
  status      OpportunityStatus   @default(NEW)
  priority    OpportunityPriority @default(MEDIUM)
  value       Decimal             @default(0) @db.Decimal(18, 4)
  probability Int                 @default(0)
  expectedCloseDate DateTime?
  assignedTo  String?             @db.Uuid
  notes       String?             @db.Text
  rowVersion  Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([companyId, status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  customerId  String?      @db.Uuid
  title       String       @db.VarChar(255)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assignedTo  String?      @db.Uuid
  completedAt DateTime?
  notes       String?      @db.Text
  rowVersion  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([assignedTo])
  @@index([dueDate])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([companyId, status])
  @@index([companyId, assignedTo])
}

model CustomerNote {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @db.Uuid
  title       String?   @db.VarChar(255)
  content     String?   @db.Text
  createdBy   String?   @db.Uuid
  rowVersion  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model CustomerAddress {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @db.Uuid
  city        String?   @db.VarChar(100)
  country     String?   @db.VarChar(100)
  street      String?   @db.VarChar(255)
  postalCode  String?   @db.VarChar(32)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([isDefault])
}

model Supplier {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @db.Uuid
  companyName   String            @db.VarChar(255)
  bin           String?           @db.VarChar(20)
  email         String?           @db.VarChar(255)
  phone         String?           @db.VarChar(64)
  website       String?           @db.VarChar(255)
  notes         String?           @db.Text
  isActive      Boolean           @default(true)
  rowVersion    Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts      SupplierContact[]
  addresses     SupplierAddress[]
  purchaseOrders     PurchaseOrder[]
  purchaseReturns    PurchaseReturn[]
  purchaseInvoices   PurchaseInvoice[]
  quotations         SupplierQuotation[]

  @@index([companyId])
  @@index([email])
  @@index([phone])
  @@index([bin])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([companyId, isActive])
  @@index([companyId, createdAt])
}

model SupplierContact {
  id            String    @id @default(uuid()) @db.Uuid
  supplierId    String    @db.Uuid
  firstName     String?   @db.VarChar(100)
  lastName      String?   @db.VarChar(100)
  phone         String?   @db.VarChar(64)
  email         String?   @db.VarChar(255)
  position      String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([email])
  @@index([phone])
}

model SupplierAddress {
  id          String    @id @default(uuid()) @db.Uuid
  supplierId  String    @db.Uuid
  city        String?   @db.VarChar(100)
  country     String?   @db.VarChar(100)
  street      String?   @db.VarChar(255)
  postalCode  String?   @db.VarChar(32)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([isDefault])
}

model User {
  id                  String         @id @default(uuid()) @db.Uuid
  email               String         @unique @db.VarChar(255)
  passwordHash        String         @db.VarChar(255)
  firstName           String?        @db.VarChar(100)
  lastName            String?        @db.VarChar(100)
  phone               String?        @db.VarChar(64)
  avatarUrl           String?        @db.Text
  position            String?        @db.VarChar(100)
  status              UserStatus     @default(ACTIVE)
  emailVerified       Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  isActive            Boolean        @default(true)
  rowVersion          Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  members             CompanyMember[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  sales               Sale[]
  cashShifts          CashShift[]
  financialPeriodsOpened   FinancialPeriod[] @relation("OpenedPeriods")
  financialPeriodsClosed   FinancialPeriod[] @relation("ClosedPeriods")
  journalEntriesPosted     JournalEntry[]   @relation("PostedJournalEntries")
  journalEntriesCreated    JournalEntry[]   @relation("CreatedJournalEntries")
  financialTransactions    FinancialTransaction[]


  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([email, deletedAt])
}

model CompanyMember {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @db.Uuid
  userId    String     @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(1000)
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  rowVersion  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
  @@index([createdAt])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(255)
  description String?          @db.VarChar(1000)
  module      String           @db.VarChar(100)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@index([createdAt])
}

model UserRole {
  id              String        @id @default(uuid()) @db.Uuid
  companyMemberId String        @db.Uuid
  roleId          String        @db.Uuid
  createdAt       DateTime      @default(now())
  companyMember   CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([companyMemberId, roleId])
  @@index([roleId])
  @@index([createdAt])
}

model Product {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  name            String            @db.VarChar(255)
  description     String?           @db.Text
  sku             String?           @db.VarChar(100)
  barcode         String?           @db.VarChar(100)
  ntin            String?           @db.VarChar(100)
  price           Decimal           @db.Decimal(18, 4)
  costPrice       Decimal?          @db.Decimal(18, 4)
  unitId          String?           @db.Uuid
  category        String?           @db.VarChar(100)
  brand           String?           @db.VarChar(100)
  costingMethod   CostingMethod     @default(AVERAGE)
  isActive        Boolean           @default(true)
  rowVersion      Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit            UnitOfMeasure?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  barcodes        ProductBarcode[]
  stocks          Stock[]
  stockMovements  StockMovement[]
  batches         Batch[]
  costLayers      CostLayer[]

  @@index([companyId])
  @@index([name])
  @@index([sku])
  @@index([barcode])
  @@index([ntin])
  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([companyId, isActive])
  @@index([companyId, createdAt])
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  sku           String?  @db.VarChar(100)
  barcode       String?  @db.VarChar(100)
  name          String   @db.VarChar(255)
  price         Decimal  @db.Decimal(18, 4)
  costPrice     Decimal? @db.Decimal(18, 4)
  attributes    Json?
  isActive      Boolean  @default(true)
  rowVersion    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([createdAt])
  @@index([productId, deletedAt])
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  barcode   String   @db.VarChar(100)
  isPrimary Boolean  @default(false)
  rowVersion Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, barcode])
  @@index([productId])
  @@index([barcode])
}

model UnitOfMeasure {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  name        String         @db.VarChar(100)
  abbreviation String        @db.VarChar(20)
  category    String?        @db.VarChar(100)
  decimalPlaces Int          @default(2)
  rowVersion  Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, name])
  @@unique([companyId, abbreviation])
  @@index([companyId])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([companyId, isActive])
}

model Batch {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  productId       String        @db.Uuid
  batchNumber     String        @db.VarChar(100)
  quantity        Int           @default(0)
  availableQuantity Int         @default(0)
  unitCost        Decimal       @db.Decimal(18, 4)
  manufactureDate DateTime?
  expiryDate      DateTime?
  receivedDate    DateTime      @default(now())
  status          StockStatus   @default(AVAILABLE)
  notes           String?       @db.Text
  rowVersion      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  costLayers      CostLayer[]

  @@unique([companyId, batchNumber])
  @@index([companyId])
  @@index([productId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, deletedAt])
  @@index([companyId, productId, status])
}

model CostLayer {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  productId       String    @db.Uuid
  batchId         String?   @db.Uuid
  direction       String    @db.VarChar(10)
  quantity        Int       @default(0)
  remainingQuantity Int     @default(0)
  unitCost        Decimal   @db.Decimal(18, 4)
  totalCost       Decimal   @db.Decimal(18, 4)
  referenceType   String?   @db.VarChar(100)
  referenceId     String?   @db.VarChar(100)
  rowVersion      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch           Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([productId])
  @@index([batchId])
  @@index([direction])
  @@index([createdAt])
