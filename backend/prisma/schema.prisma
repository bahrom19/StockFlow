model CashShift {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  warehouseId    String         @db.Uuid
  cashierId      String         @db.Uuid
  status         CashShiftStatus @default(OPEN)
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  openingBalance Decimal        @default(0) @db.Decimal(18, 4)
  closingBalance Decimal        @default(0) @db.Decimal(18, 4)
  cashSales      Decimal        @default(0) @db.Decimal(18, 4)
  cardSales      Decimal        @default(0) @db.Decimal(18, 4)
  qrSales        Decimal        @default(0) @db.Decimal(18, 4)
  bankTransferSales Decimal     @default(0) @db.Decimal(18, 4)
  mobileWalletSales Decimal     @default(0) @db.Decimal(18, 4)
  totalSales     Decimal        @default(0) @db.Decimal(18, 4)
  cashIn         Decimal        @default(0) @db.Decimal(18, 4)
  cashOut        Decimal        @default(0) @db.Decimal(18, 4)
  expectedClosing Decimal       @default(0) @db.Decimal(18, 4)
