enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
  FREE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  REFUNDED
  DISPUTED
  CANCELLED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

model SubscriptionPlan {
